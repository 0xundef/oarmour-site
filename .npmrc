# @anthropic-ai/claude-agent-sdk declares peer zod ^4, but the project (and the
# AI SDK) use zod ^3.25.76. The agent SDK is runtime-compatible with zod v3
# (verified: tool()/createSdkMcpServer construct fine against the top-level
# zod v3.25.76 instance). Use legacy-peer-deps so installs don't ERESOLVE.
legacy-peer-deps=true
